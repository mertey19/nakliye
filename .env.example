# ÖNERİLEN: Kanonik URL'ler, sitemap ve JSON-LD bu adrese göre üretilir.
# Sonunda "/" OLMAYACAK. Kanonik biçim: https (non-www).
#
# Tanımlı değilse sırayla şuna düşer:
#   1) VERCEL_PROJECT_PRODUCTION_URL (Vercel otomatik verir)
#   2) https://kansucannakliye.com (yer tutucu — derleme log'unda uyarı çıkar)
# Yani dağıtım yine çalışır, ama gerçek alan adınız belliyse mutlaka girin.
NEXT_PUBLIC_SITE_URL=https://kansucannakliye.com

# OPSİYONEL: GA4 ölçüm kimliği. Boş bırakılırsa hiçbir analytics scripti yüklenmez.
NEXT_PUBLIC_GA_ID=

# OPSİYONEL: Google Search Console HTML meta doğrulaması
NEXT_PUBLIC_GSC_VERIFICATION=
